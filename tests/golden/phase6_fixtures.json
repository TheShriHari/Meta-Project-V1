      "nu",
      "burgers_m",
      "taylor_factor",
      "tau_src_pa (=0)"
    ],
    "predicted_on_held_out": "sigma_y(d) at held-out grain sizes, compared with held_out_fit sigma_0 + k_y d^-1/2",
    "headline_metric": "held_out_unadjusted_mean_rel_error: held-out material's own sigma_0 and k_y are NOT used anywhere in the prediction (uses calibration sigma_0 + calibrated tau*_ref).",
